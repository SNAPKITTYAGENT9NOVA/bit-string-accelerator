module BitAddressing

  use int.Int
  use bv.BV64

  (* ============================================================
     Bit Addressing and Extraction Formal Specification
     ============================================================ *)

  (* Physical constraints *)
  constant word_bits : int = 64
  constant max_address : int = 281474976710656  (* 2^48 - 1, valid memory range *)

  (* Predicate: is_valid_bit_address *)
  predicate is_valid_bit_address (addr : int) =
    0 <= addr && addr < max_address * word_bits

  (* Predicate: word_aligned *)
  predicate word_aligned (addr : int) =
    addr mod word_bits = 0

  (* ============================================================
     Core Address Calculation Functions
     ============================================================ *)

  (* Calculate effective bit address: base_address (in bytes) + bit_offset *)
  function absolute_bit_address (base_byte_addr : int) (bit_offset : int) : int =
    (base_byte_addr * 8) + bit_offset

  (* Calculate word index from bit address *)
  function word_index (bit_addr : int) : int =
    bit_addr / word_bits

  (* Calculate bit position within word *)
  function bit_index_in_word (bit_addr : int) : int =
    bit_addr mod word_bits

  (* ============================================================
     Correctness Theorems: Address Calculation
     ============================================================ *)

  theorem absolute_bit_address_valid :
    forall base : int, offset : int.
      (0 <= base && 0 <= offset) ->
      (absolute_bit_address base offset >= 0)

  theorem word_index_positive :
    forall bit_addr : int.
      (0 <= bit_addr && is_valid_bit_address bit_addr) ->
      (0 <= word_index bit_addr && word_index bit_addr < max_address)

  theorem bit_index_in_range :
    forall bit_addr : int.
      is_valid_bit_address bit_addr ->
      (0 <= bit_index_in_word bit_addr && bit_index_in_word bit_addr < word_bits)

  theorem bit_index_less_than_64 :
    forall bit_addr : int.
      is_valid_bit_address bit_addr ->
      bit_index_in_word bit_addr < 64

  (* ============================================================
     Correctness Theorems: Division Property
     ============================================================ *)

  theorem euclidean_division :
    forall bit_addr : int.
      is_valid_bit_address bit_addr ->
      bit_addr = (word_index bit_addr * word_bits) + bit_index_in_word bit_addr

  theorem word_index_uniqueness :
    forall bit_addr1 bit_addr2 : int.
      is_valid_bit_address bit_addr1 ->
      is_valid_bit_address bit_addr2 ->
      (word_index bit_addr1 = word_index bit_addr2) ->
      ((bit_addr1 / word_bits) = (bit_addr2 / word_bits))

  (* ============================================================
     Single-Bit Extraction Specification
     ============================================================ *)

  (* BIT_GET(base, offset) reads a single bit from memory *)
  (* Precondition: memory access valid *)
  (* Return value: bit value (0 or 1) *)
  (* Postcondition: result = (memory[word_index] >> bit_index) & 1 *)

  predicate bit_get_correct (memory : int -> int) (base : int) (offset : int) (result : int) =
    let bit_addr = absolute_bit_address base offset in
    let w_idx = word_index bit_addr in
    let b_idx = bit_index_in_word bit_addr in
    is_valid_bit_address bit_addr &&
    (result = ((memory w_idx) / (2 ^ b_idx)) mod 2) &&
    (result = 0 || result = 1)

  theorem bit_get_binary :
    forall memory base offset result : int.
      bit_get_correct memory base offset result ->
      (result = 0 || result = 1)

  theorem bit_get_deterministic :
    forall memory base offset result1 result2 : int.
      bit_get_correct memory base offset result1 ->
      bit_get_correct memory base offset result2 ->
      result1 = result2

  (* ============================================================
     Single-Bit Modification Specification
     ============================================================ *)

  (* BIT_SET(base, offset) sets a single bit to 1 *)
  predicate bit_set_correct (old_mem : int -> int) (new_mem : int -> int) (base : int) (offset : int) =
    let bit_addr = absolute_bit_address base offset in
    let w_idx = word_index bit_addr in
    let b_idx = bit_index_in_word bit_addr in
    is_valid_bit_address bit_addr &&
    (* Modified bit is now 1 *)
    (((new_mem w_idx) / (2 ^ b_idx)) mod 2 = 1) &&
    (* All other bits are unchanged *)
    (forall addr : int. addr <> w_idx -> new_mem addr = old_mem addr)

  (* BIT_CLEAR(base, offset) clears a single bit to 0 *)
  predicate bit_clear_correct (old_mem : int -> int) (new_mem : int -> int) (base : int) (offset : int) =
    let bit_addr = absolute_bit_address base offset in
    let w_idx = word_index bit_addr in
    let b_idx = bit_index_in_word bit_addr in
    is_valid_bit_address bit_addr &&
    (* Modified bit is now 0 *)
    (((new_mem w_idx) / (2 ^ b_idx)) mod 2 = 0) &&
    (* All other bits are unchanged *)
    (forall addr : int. addr <> w_idx -> new_mem addr = old_mem addr)

  (* BIT_TOGGLE(base, offset) flips a single bit *)
  predicate bit_toggle_correct (old_mem : int -> int) (new_mem : int -> int) (base : int) (offset : int) =
    let bit_addr = absolute_bit_address base offset in
    let w_idx = word_index bit_addr in
    let b_idx = bit_index_in_word bit_addr in
    is_valid_bit_address bit_addr &&
    (* Modified bit is inverted *)
    (((new_mem w_idx) / (2 ^ b_idx)) mod 2 = 1 - (((old_mem w_idx) / (2 ^ b_idx)) mod 2)) &&
    (* All other bits are unchanged *)
    (forall addr : int. addr <> w_idx -> new_mem addr = old_mem addr)

  (* ============================================================
     Boundary Condition Theorems
     ============================================================ *)

  theorem bit_0_maps_to_word_0 :
    forall base : int.
      is_valid_bit_address (absolute_bit_address base 0) ->
      word_index (absolute_bit_address base 0) = base / 8

  theorem bit_63_same_word :
    forall base : int.
      is_valid_bit_address (absolute_bit_address base 0) &&
      is_valid_bit_address (absolute_bit_address base 63) ->
      word_index (absolute_bit_address base 0) = word_index (absolute_bit_address base 63)

  theorem bit_64_next_word :
    forall base : int.
      is_valid_bit_address (absolute_bit_address base 0) &&
      is_valid_bit_address (absolute_bit_address base 64) ->
      word_index (absolute_bit_address base 64) = word_index (absolute_bit_address base 0) + 1

  theorem bit_index_wraps_at_64 :
    forall base : int.
      is_valid_bit_address (absolute_bit_address base 63) &&
      is_valid_bit_address (absolute_bit_address base 64) ->
      bit_index_in_word (absolute_bit_address base 63) = 63 &&
      bit_index_in_word (absolute_bit_address base 64) = 0

  (* ============================================================
     Non-Interference Theorems
     ============================================================ *)

  theorem disjoint_words_independent :
    forall base1 base2 offset1 offset2 : int.
      word_index (absolute_bit_address base1 offset1) <>
      word_index (absolute_bit_address base2 offset2) ->
      (forall m1 m2 old_mem new_mem : int -> int.
        bit_set_correct old_mem new_mem base1 offset1 ->
        bit_get_correct new_mem base2 offset2 m2 ->
        bit_get_correct old_mem base2 offset2 m2)

  theorem within_word_uniqueness :
    forall base : int, offset1 offset2 : int.
      offset1 <> offset2 &&
      is_valid_bit_address (absolute_bit_address base offset1) &&
      is_valid_bit_address (absolute_bit_address base offset2) &&
      bit_index_in_word (absolute_bit_address base offset1) = bit_index_in_word (absolute_bit_address base offset2) ->
      false

end
